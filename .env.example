# Google Gemini AI key (server-side, used by /api/ai-consultant).
# Without it the endpoint returns a curated fallback recommendation.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase web app configuration (Vite exposes VITE_* to the client).
# Without these the contact form falls back to a mailto: handoff.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=srirealtime-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=srirealtime-web
VITE_FIREBASE_STORAGE_BUCKET=srirealtime-web.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ---------------------------------------------------------------------------
# Contact form email delivery (server-side, used by POST /api/contact)
# Without these the form falls back to Firestore, then to a mailto: handoff.
#
# Google Workspace / Gmail: host smtp.gmail.com, port 465, and an App Password
# (myaccount.google.com > Security > 2-Step Verification > App passwords).
# Your normal account password will not work.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=org@srirealtime.com
SMTP_PASS=your_smtp_app_password

# Where enquiries are delivered, and what the From line reads as.
CONTACT_TO=org@srirealtime.com
CONTACT_FROM="SRI REAL TIME Website" <org@srirealtime.com>

# ---------------------------------------------------------------------------
# Chat widget (optional). Unset = no widget loads.
#
# Do NOT put a localhost URL here: .env.local is read for production builds
# too, and the URL is inlined at build time — every visitor would then try to
# load the widget from their own machine. Keep the local value in
# .env.development.local (dev mode only) and set the real https URL here.
# ---------------------------------------------------------------------------
VITE_CHAT_WIDGET_URL=https://chat.srirealtime.com/widget.js
VITE_CHAT_WIDGET_KEY=your_widget_key
# Optional; the widget picks its own corner if unset. Back-to-top sits
# bottom-left, so leave the chat bubble on the right.
# VITE_CHAT_WIDGET_POSITION=bottom-right
